library(DESeq2)
library(readr)
library(dplyr)
library(cowplot)
library(ggrepel)
# Plot 2D PCA for the given expression object X, the given components pc1, pc2,
# using the most variable genes based on pval and the given colour palette and
# title. Points are coloured by condition cond.
plot_pca <- function(X, cond, pc1 = 1, pc2 = 2, pval = 0.001, col_pal, ptitle){
# Detecting variable genes (corrected p-val < 0.001)
fit <- scran::trendVar(assay(X))
decomp <- scran::decomposeVar(assay(X), fit)
idx <- which(decomp$FDR < pval)
ntop <- length(idx)
# vargenes <- rowVars(assay(X))
# idx <- order(vargenes, decreasing = TRUE)[seq_len(min(ntop, length(vargenes)))]
mat <- t(assay(X)[idx, ])
pca <- prcomp(mat)
res <- tibble(x = pca$x[, pc1], y = pca$x[, pc2], cond = colData(X)[, cond])
pca_var <- summary(pca)$importance
pc1_var <- round(pca_var["Proportion of Variance", pc1] * 100)
pc2_var <- round(pca_var["Proportion of Variance", pc2] * 100)
p_pca <- ggplot(res, aes(x, y, colour = cond)) +
geom_point(size = 2.5) +
scale_colour_manual(values = col_pal) +
labs(x = paste0("PC", pc1, ": ", pc1_var, "% variance"),
y = paste0("PC", pc2, ": ", pc2_var, "% variance"),
title = paste0(ptitle, " (n = ", ntop, ", adjusted P = ", pval, ")"),
colour = "") +
theme_bw(base_size = 15)
return(p_pca)
}
