load("results/hesc.RData")
# Read in the sample aliases and arrange to match the count matrix column order
stype <- read_tsv("all_samples.tsv")
stype$medium[is.na(stype$medium)] <- ""
stype <- stype %>%
mutate(sample_type = factor(paste0(cell_line, " ", medium, " (",
stringr::str_to_title(batch), " et al.)")))
col_pal <- c("#252525", "#969696", #CH cells
"#1f78b4", "#6baed6", #Derived cells
"#4d9221", "#7fbc41", "#a6d96a", #Epi
"#bcbddc", "#807dba", "#54278f", #H1 cells
"#F5DEB3", "#D2B48C", "#CD7F32", "#C19A6B", "#a0785a", "#964B00", #H9 cells
"#de77ae", "#f1b6da", #HNES1 cells
"#99d8c9", "#41ae76", #PE
"#FFEF00", "#FFA500", "#FCE883", "#EFCC00", #Shef6 cells
"#fc9272", "#ef3b2c") #WIBR3
# Putting all the data together, removal of genes not expressed in any sample
# and removal of mitochondrial genes
dds <- DESeqDataSetFromTximport(txi = hesc, colData = stype,
design = ~ condition)
dds <- dds[rowSums(counts(dds) > 0) >= round(ncol(dds)*0.1), ]
mito <- grep("^MT-", rownames(dds))
dds <- dds[-mito, ]
# Variance stabilisation of counts
vsd <- vst(dds)
