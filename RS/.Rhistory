exp_scr <- read_tsv("experimental_scores.tsv")
det_method_scr <- vector("numeric", length = nrow(mippie_rs))
for(i in 1:nrow(exp_scr)){
det_method_scr[grep(exp_scr$PSI[i],
mippie_rs$exp_techniques)] <-
det_method_scr[grep(exp_scr$PSI[i],
mippie_rs$exp_techniques)] + exp_scr$score[i]
}
